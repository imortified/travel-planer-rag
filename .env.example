POSTGRES_DB=travel_planner
POSTGRES_USER=travel
POSTGRES_PASSWORD=local_dev_only
POSTGRES_PORT=55432
DATABASE_URL=postgresql+psycopg://travel:local_dev_only@127.0.0.1:55432/travel_planner
OSM_MAP_URL=https://www.openstreetmap.org/api/0.6/map
OSRM_URL=https://router.project-osrm.org
LLM_BASE_URL=http://127.0.0.1:8081
LLM_MODEL=Qwen3-4B-Q4_K_M
LLM_TIMEOUT_SECONDS=60
# HTTPS deployment: set true. Local HTTP on 127.0.0.1 uses false.
AUTH_COOKIE_SECURE=false
AUTH_SESSION_DAYS=7
AUTH_ALLOWED_ORIGINS=["http://127.0.0.1:3001","http://localhost:3001","http://127.0.0.1:8001","http://localhost:8001"]
LLM_EXPLANATION_TIMEOUT_SECONDS=120
EMBEDDING_BASE_URL=http://127.0.0.1:8082
EMBEDDING_MODEL=Qwen3-Embedding-0.6B-Q8_0
EMBEDDING_TIMEOUT_SECONDS=60
QDRANT_URL=http://127.0.0.1:6333
QDRANT_TIMEOUT_SECONDS=10
QDRANT_COLLECTION_PREFIX=travel
# Set only when connecting to a Qdrant instance that requires authentication.
QDRANT_API_KEY=
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CACHE_PREFIX=travel:http:v1
REDIS_TIMEOUT_SECONDS=1
OSM_CACHE_TTL_SECONDS=86400
OSRM_CACHE_TTL_SECONDS=3600
# Xotelo public observations. Rates 1-15 minutes; directory at most one day.
XOTELO_RATES_TTL_SECONDS=600
XOTELO_LIST_TTL_SECONDS=86400
XOTELO_TIMEOUT_SECONDS=30
# Published PostgreSQL catalog freshness policy: 1 hour to 7 days, independent of Redis TTL.
CATALOG_MAX_AGE_SECONDS=604800
# JSON logging; path is relative to the project root. Empty LOG_FILE disables the file.
LOG_LEVEL=INFO
LOG_FILE=.local/logs/backend.log
LOG_MAX_BYTES=5000000
LOG_BACKUP_COUNT=3
# Optional: free-plan SerpApi key for the opt-in hotel-provider experiment only.
# Never commit the actual key. The runner checks the Free plan and caps searches at 8.
SERPAPI_API_KEY=
# Optional: read-only Aviasales Data API pilot. Token stays on the backend only.
TRAVELPAYOUTS_API_TOKEN=
AVIASALES_CACHE_TTL_SECONDS=3600
AVIASALES_TIMEOUT_SECONDS=30
